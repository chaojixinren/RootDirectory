# Nexus 环境变量配置

# LLM配置
LLM_API_KEY=
LLM_BASE_URL=https://qianfan.baidubce.com/v2/coding
LLM_DEFAULT_MODEL=glm-5

# 可选：配置不同的模型给不同Agent
AGENT_ORCHESTRATOR_MODEL=gpt-4o
AGENT_THINKER_MODEL=gpt-4o
AGENT_EXECUTOR_MODEL=gpt-4o-mini
AGENT_REFLECTOR_MODEL=gpt-4o
AGENT_MEMORY_MODEL=gpt-4o-mini

# 工作流配置
WORKFLOW_MAX_ROUNDS=20
WORKFLOW_STALL_THRESHOLD=3

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_LOG_LEVEL=info
